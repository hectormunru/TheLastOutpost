<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="achievement"
            type="com.example.thelastoutpost.model.Achievement" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/ice_border"
        android:alpha="@{achievement.isUnlocked ? 1.0f : 0.7f}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_frosted_panel"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivAchievementIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_castle"
                android:layout_marginEnd="16dp"
                android:background="@color/ice_border"
                android:padding="4dp"
                android:alpha="@{achievement.isUnlocked ? 1.0f : 0.3f}" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{achievement.title}"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{achievement.description}"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{achievement.isUnlocked ? @string/achievement_unlocked : @string/achievement_locked}"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@{achievement.isUnlocked ? @color/achievement_unlocked : @color/achievement_locked}" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
