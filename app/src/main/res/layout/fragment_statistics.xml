<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sky_medieval"
        android:backgroundTint="#66000000"
        android:backgroundTintMode="src_over"
        tools:context="com.example.thelastoutpost.ui.StatisticsFragment">

        

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_frosted_panel"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/stats_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:layout_marginBottom="32dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvEnemiesKilled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="16dp"
                    tools:text="Enemigos derrotados: 42" />

                <TextView
                    android:id="@+id/tvGoldEarned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="16dp"
                    tools:text="Oro total recolectado: 1250" />

                <TextView
                    android:id="@+id/tvMaxWave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/text_main"
                    tools:text="Máxima oleada alcanzada: 12" />

            </LinearLayout>

            <Button
                android:id="@+id/btnBackFromStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_btn_back"
                android:background="@drawable/btn_arctic_primary"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:padding="16dp"
                android:layout_marginTop="32dp" />

        </LinearLayout>
    </FrameLayout>
</layout>
